{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/app/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/demo/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/auth/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/login",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/signup",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/forgot-password",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/login",
      "destination": "/login/index.html"
    },
    {
      "source": "/signup",
      "destination": "/signup/index.html"
    },
    {
      "source": "/forgot-password",
      "destination": "/forgot-password/index.html"
    },
    {
      "source": "/auth/callback",
      "destination": "/auth/callback/index.html"
    },
    {
      "source": "/app/overview",
      "destination": "/app/overview/index.html"
    },
    {
      "source": "/app/money-log",
      "destination": "/app/money-log/index.html"
    },
    {
      "source": "/app/income",
      "destination": "/app/income/index.html"
    },
    {
      "source": "/app/money-plan",
      "destination": "/app/money-plan/index.html"
    },
    {
      "source": "/app/reports",
      "destination": "/app/reports/index.html"
    },
    {
      "source": "/app/categories",
      "destination": "/app/categories/index.html"
    },
    {
      "source": "/app/settings",
      "destination": "/app/settings/index.html"
    },
    {
      "source": "/app/admin",
      "destination": "/app/admin/index.html"
    },
    {
      "source": "/demo/overview",
      "destination": "/demo/overview/index.html"
    },
    {
      "source": "/demo/money-log",
      "destination": "/demo/money-log/index.html"
    },
    {
      "source": "/demo/income",
      "destination": "/demo/income/index.html"
    },
    {
      "source": "/demo/money-plan",
      "destination": "/demo/money-plan/index.html"
    },
    {
      "source": "/demo/reports",
      "destination": "/demo/reports/index.html"
    },
    {
      "source": "/demo/categories",
      "destination": "/demo/categories/index.html"
    },
    {
      "source": "/demo/settings",
      "destination": "/demo/settings/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/guide",
      "destination": "/guide/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/how-to-track-daily-expenses",
      "destination": "/blog/how-to-track-daily-expenses/index.html"
    },
    {
      "source": "/blog/budget-around-payday",
      "destination": "/blog/budget-around-payday/index.html"
    },
    {
      "source": "/blog/budget-with-irregular-income",
      "destination": "/blog/budget-with-irregular-income/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/about.html",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/guide.html",
      "destination": "/guide",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/terms.html",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/app",
      "destination": "/app/overview",
      "permanent": false
    },
    {
      "source": "/demo",
      "destination": "/demo/overview",
      "permanent": false
    },
    {
      "source": "/app/entries",
      "destination": "/app/money-log",
      "permanent": true
    },
    {
      "source": "/app/budgets",
      "destination": "/app/money-plan",
      "permanent": true
    },
    {
      "source": "/app/goals",
      "destination": "/app/money-plan",
      "permanent": true
    },
    {
      "source": "/demo/entries",
      "destination": "/demo/money-log",
      "permanent": true
    },
    {
      "source": "/demo/budgets",
      "destination": "/demo/money-plan",
      "permanent": true
    },
    {
      "source": "/demo/goals",
      "destination": "/demo/money-plan",
      "permanent": true
    }
  ],
  "trailingSlash": false
}
